# Copy to .env and fill in. Never commit .env.

# Required. A `postgres://` URL from a hosted provider is fine — config.py
# normalises it to postgresql+psycopg:// for you.
DATABASE_URL=postgresql://pokeclo:pokeclo@localhost:5432/pokeclo_py

# Optional. Log every SQL statement SQLAlchemy sends. Useful while learning.
SQL_ECHO=false

# Optional. Origins allowed to call the API from a browser, as a JSON array —
# pydantic-settings parses list[str] fields as JSON, so bare comma-separated
# values will NOT work. Unused in development thanks to the Vite proxy; set it
# to your deployed frontend's origin in production.
CORS_ORIGINS=["http://localhost:5173"]
